# Copy to .env for local development. For Google Cloud Run, scripts/deploy-cloud-run.sh
# creates .env.production with the same names.

# Postgres. In production: the Neon connection string.
DATABASE_URL=postgres://postgres@localhost:5432/wout

# Where the app is reachable. Google redirects back to $APP_URL/api/auth/google/callback.
APP_URL=http://localhost:8080

# Google Cloud → APIs & Services → Credentials → OAuth client ID (type: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in (comma-separated Google accounts). Everyone else is refused.
ALLOWED_EMAILS=you@gmail.com

# Signs the login cookie. Any long random string: openssl rand -hex 32
SESSION_SECRET=

# console.anthropic.com → API keys. Writes the briefings (Claude Opus 5.5).
ANTHROPIC_API_KEY=

# Lets Cloud Scheduler trigger the morning briefing (POST /api/jobs/daily, x-cron-secret header).
CRON_SECRET=

# Optional: enables POST /api/webhooks/funding (send it as the x-webhook-secret header).
WEBHOOK_SECRET=
